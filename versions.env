# ==============================================================================
# Pinned versions for nert (Neuriplo Engine Runtime)
# ==============================================================================
#
# This file is the single home for every version number the build, the
# specs, and the parity runs depend on. CMake reads NERT_VERSION from
# here (with a fallback when the file is absent, e.g. FetchContent
# consumers); everything else is documentation that specs cite instead
# of hardcoding versions in prose.
#
# HOW TO CHANGE A PIN:
# --------------------
# 1. Edit the value here.
# 2. Grep specs/ and CMake for the old value and update citations.
# 3. Re-run the affected validation leg and record it.
#
# ==============================================================================

# Own version (read by CMakeLists.txt; keep in sync with CHANGELOG.md).
NERT_VERSION=0.2.0

# ONNX opset the loader accepts (kRequiredOpsetVersion). Older exports must
# be converted (onnx.version_converter) with a recorded parity check.
NERT_ONNX_OPSET=18

# ONNX Runtime version the CPU/GPU parity runs compare against.
ONNX_RUNTIME_PARITY_VERSION=1.27.0

# GPU device layers (opt-in NERT_ENABLE_* flags; OFF by default).
CUDA_CONTAINER_VERSION=13.4
CUDA_HOST_VERSION=12.0
CUDNN_VERSION=9.25.0
CUDNN_FRONTEND_VERSION=1.31.0
HIP_HEADERS_VERSION=6.2

# Build floor.
CMAKE_MINIMUM_VERSION=3.16
CXX_STANDARD=17
GTEST_VERSION=1.14.0

# Model-export tooling (scratch only, never linked into the runtime).
TORCH_VERSION=2.12.0
TORCHVISION_VERSION=0.27.0
ONNX_PYTHON_VERSION=1.22.0
TRANSFORMERS_VERSION=5.20.1
